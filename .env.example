# CPMM2067 — local dev secrets. Copy to .env (which is gitignored).
# All keys are optional; the in-app Settings panel can also store them.

# Nexus Mods API key — generate at https://www.nexusmods.com/users/myaccount?tab=api
NEXUS_API_KEY=

# Sentry DSN for opt-in telemetry (leave empty to disable)
SENTRY_DSN=

# Override the GitHub releases feed used by the in-app self-updater
# UPDATE_FEED_URL=https://github.com/your/fork/releases
