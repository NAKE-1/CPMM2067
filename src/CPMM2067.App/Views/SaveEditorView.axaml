<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CPMM2067.App.ViewModels"
             x:Class="CPMM2067.App.Views.SaveEditorView"
             x:DataType="vm:SaveEditorViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14" Margin="0,0,0,40">
        <TextBlock Classes="PanelLabel" Text="// SAVE EDITOR"/>
        <TextBlock Classes="Heading" Text="save editor (external)"/>

        <Border Classes="Panel">
            <StackPanel Spacing="10">
                <TextBlock Classes="Mono" Foreground="{DynamicResource Accent2Brush}" xml:space="preserve">┌──────────────────────────────────────────────────────────┐
│  EXTERNAL TOOL :: CyberCAT-SimpleGUI                     │
│  CPMM2067 launches it; doesn't bundle a CR2W parser yet. │
└──────────────────────────────────────────────────────────┘</TextBlock>
                <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource Text2Brush}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Classes="Sub"/>
            </StackPanel>
        </Border>

        <Border Classes="Panel">
            <StackPanel Spacing="8">
                <TextBlock Classes="PanelLabel" Text="[ CYBERCAT-SIMPLEGUI EXE PATH ]"/>
                <TextBlock Classes="Sub" TextWrapping="Wrap"
                           Text="Where CP2077SaveEditor.exe lives on your machine. Empty = not configured."/>
                <TextBox Text="{Binding SaveEditorExe, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="[ auto-detect ]" Command="{Binding AutoDetectCommand}"/>
                    <Button Content="[ pick exe… ]" Command="{Binding PickExeCommand}"/>
                    <Button Content="[ download ]" Command="{Binding DownloadCommand}"
                            ToolTip.Tip="Opens the Nexus page for CyberCAT-SimpleGUI in your preferred browser"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="Panel">
            <StackPanel Spacing="8">
                <TextBlock Classes="PanelLabel" Text="[ OPEN A SAVE ]"/>
                <Button Classes="Accent" Content="[ PICK SAVE + OPEN ]"
                        Command="{Binding PickSaveAndOpenCommand}"
                        HorizontalAlignment="Left"/>
                <TextBlock Classes="Mono" Text="{Binding Status}"
                           Foreground="{DynamicResource Accent1Brush}"
                           TextWrapping="Wrap"/>
                <TextBlock Classes="Sub" TextWrapping="Wrap"
                           Text="Pick a save folder (defaults to your CP2077 saves directory). We pass the contained sav.dat to CyberCAT-SimpleGUI. The Saves page also has per-row [ EDIT ] buttons that do the same thing."/>
            </StackPanel>
        </Border>

        <Border Classes="Panel">
            <StackPanel Spacing="6">
                <TextBlock Classes="PanelLabel" Text="[ WHY EXTERNAL? ]"/>
                <TextBlock Classes="Sub" TextWrapping="Wrap"
                           Text="Cyberpunk's save format (CR2W binary, zlib-chunked) is partially reverse-engineered. Properly editing inventory / perks / attributes / appearance requires a full CR2W parser. CyberCAT-SimpleGUI (community-maintained) is the established tool, has ~7.4k Nexus endorsements, and is regularly updated for new patches. Bundling a from-scratch parser would risk corruption and is a multi-week project. We delegate to the established tool instead."/>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
